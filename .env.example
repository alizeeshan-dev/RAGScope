RAGSCOPE_ENVIRONMENT=development
RAGSCOPE_DATABASE_URL=postgresql+psycopg://ragscope:ragscope@db:5432/ragscope
RAGSCOPE_ARTIFACT_ROOT=/var/lib/ragscope/artifacts
RAGSCOPE_MAX_UPLOAD_BYTES=52428800
RAGSCOPE_CORS_ORIGINS=http://localhost:3000
RAGSCOPE_EMBEDDING_PROVIDER=fake
RAGSCOPE_EMBEDDING_MODEL=fake-hash-embedding-v1
RAGSCOPE_EMBEDDING_DIMENSION=64
RAGSCOPE_EMBEDDING_TIMEOUT_SECONDS=60
RAGSCOPE_GENERATION_PROVIDER=fake
RAGSCOPE_GENERATION_MODEL=fake-generation-v1
RAGSCOPE_GENERATION_BASE_URL=https://api.openai.com/v1
RAGSCOPE_GENERATION_API_KEY=
RAGSCOPE_GENERATION_TIMEOUT_SECONDS=60
RAGSCOPE_GENERATION_INPUT_PRICE_PER_MILLION=
RAGSCOPE_GENERATION_OUTPUT_PRICE_PER_MILLION=
RAGSCOPE_EMBEDDING_INPUT_PRICE_PER_MILLION=
# Optional USD guard. Experiment start is rejected when a complete estimate exceeds it.
RAGSCOPE_EXPERIMENT_COST_LIMIT=
RAGSCOPE_JOB_API_DEFAULT_WAIT=false
RAGSCOPE_GEMINI_API_KEY=
RAGSCOPE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
RAGSCOPE_GEMINI_MODEL=gemini-2.5-flash
RAGSCOPE_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAGSCOPE_GEMINI_EMBEDDING_DIMENSION=768
RAGSCOPE_GEMINI_EMBEDDING_BATCH_SIZE=100
RAGSCOPE_GEMINI_EMBEDDING_TASK_TYPE=SEMANTIC_SIMILARITY
# Set true only when building the optional local CrossEncoder container dependency.
RAGSCOPE_INSTALL_RERANKER=false
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
